          },
          "format": 1,
          "rawSQL": "SELECT event_type, COUNT(DISTINCT session_sk) AS unique_sessions\nFROM delta.gold.fact_clickstream_events\nGROUP BY event_type\nORDER BY unique_sessions DESC"
