            "uid": "trino-delta"
          },
          "format": 1,
          "rawSQL": "SELECT c.country, ROUND(SUM(o.total_usd), 2) AS revenue_usd\nFROM delta.gold.fact_click_orders o\nJOIN delta.gold.dim_click_customer c ON o.customer_sk = c.customer_sk\nGROUP BY c.country\nORDER BY revenue_usd DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
