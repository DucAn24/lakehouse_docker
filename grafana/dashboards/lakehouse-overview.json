    {
      "id": 18,
      "type": "barchart",
      "title": "Revenue by country (top 10, USD)",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino-delta"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
