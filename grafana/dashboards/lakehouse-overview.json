    {
      "id": 9,
      "type": "barchart",
      "title": "Top categories by sales",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino-delta"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
