    {
      "id": 7,
      "type": "barchart",
      "title": "Monthly revenue",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino-delta"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino-delta"
          },
          "format": 1,
          "rawSQL": "SELECT d.year_month AS month, ROUND(SUM(f.total_item_value), 2) AS revenue\nFROM delta.gold.fact_orders f\nJOIN delta.gold.dim_date d ON f.date_sk = d.date_sk\nGROUP BY d.year_month\nORDER BY d.year_month"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "currencyBRL"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
        "showValue": "auto",
        "xTickLabelRotation": -45
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Revenue by state (top 10)",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino-delta"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
