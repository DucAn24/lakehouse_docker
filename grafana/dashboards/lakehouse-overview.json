      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino-delta"
          },
          "format": 1,
          "rawSQL": "SELECT p.product_category_name_english AS category,\n    COUNT(*) AS total_reviews,\n    ROUND(AVG(r.review_score), 2) AS avg_score,\n    ROUND(SUM(r.is_positive) * 100.0 / COUNT(*), 2) AS positive_rate_pct\nFROM delta.gold.fact_reviews r\nJOIN delta.gold.fact_orders f ON r.order_id = f.order_id\nJOIN delta.gold.dim_product p ON f.product_sk = p.product_sk\nGROUP BY p.product_category_name_english\nORDER BY total_reviews DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
