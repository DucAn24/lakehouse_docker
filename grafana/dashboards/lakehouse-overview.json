    {
      "id": 19,
      "type": "table",
      "title": "Sessions by device & traffic source",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino-delta"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino-delta"
          },
          "format": 1,
          "rawSQL": "SELECT d.device, ts.traffic_source,\n    COUNT(DISTINCT s.session_sk) AS total_sessions,\n    COUNT(e.event_sk) AS total_events,\n    ROUND(CAST(COUNT(e.event_sk) AS DOUBLE) / COUNT(DISTINCT s.session_sk), 2) AS avg_actions_per_session\nFROM delta.gold.fact_sessions s\nJOIN delta.gold.dim_device d ON s.device_sk = d.device_sk\nJOIN delta.gold.dim_traffic_source ts ON s.source_sk = ts.source_sk\nLEFT JOIN delta.gold.fact_clickstream_events e ON s.session_sk = e.session_sk\nGROUP BY d.device, ts.traffic_source\nORDER BY total_sessions DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
