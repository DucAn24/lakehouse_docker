          "format": 1,
          "rawSQL": "SELECT d.device, ROUND(SUM(o.total_usd), 2) AS revenue_usd\nFROM delta.gold.fact_click_orders o\nJOIN delta.gold.dim_device d ON o.device_sk = d.device_sk\nGROUP BY d.device\nORDER BY revenue_usd DESC"
