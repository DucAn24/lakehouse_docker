          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino-delta"
          },
          "format": 1,
          "rawSQL": "SELECT p.product_category_name_english AS category, ROUND(SUM(f.unit_price), 2) AS total_sales\nFROM delta.gold.fact_orders f\nJOIN delta.gold.dim_product p ON f.product_sk = p.product_sk\nGROUP BY p.product_category_name_english\nORDER BY total_sales DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "currencyBRL"
