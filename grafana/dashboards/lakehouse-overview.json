            "uid": "trino-delta"
          },
          "format": 1,
          "rawSQL": "SELECT c.customer_state AS state, ROUND(SUM(f.total_item_value), 2) AS revenue\nFROM delta.gold.fact_orders f\nJOIN delta.gold.dim_customer c ON f.customer_sk = c.customer_sk\nGROUP BY c.customer_state\nORDER BY revenue DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
