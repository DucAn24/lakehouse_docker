# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Lưu ý: connectors/*.json đang hard-code postgres/123456 — đổi mật khẩu Postgres thì sửa cả các file đó.
# (trino/catalog/lakehouse.properties đọc key S3/Polaris từ biến môi trường, không hard-code.)

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=orders

# --- S3 storage (SeaweedFS, service `s3`) ---
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
AWS_REGION=us-east-1

# --- Apache Polaris (Iceberg REST catalog `lakehouse`) ---
# Root principal, tạo bởi polaris-bootstrap ở lần chạy đầu (đổi sau đó không có tác dụng: realm đã bootstrap).
# Spark, Trino, catalog-api, Polaris Console và examples/ đều đăng nhập bằng cặp này.
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=YOUR_POLARIS_ROOT_SECRET
# POLARIS_VERSION=1.7.0

# --- Airflow ---
AIRFLOW_FERNET_KEY=VmmHTQ7ypdnXrMx2IGsJCy-GElj-ybGzqiqbakBck6U=

# --- MiMo AI Chatbot ---
MIMO_API_KEY=YOUR_MIMO_API_KEY
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Cảnh báo pipeline (Slack-compatible incoming webhook; để trống = tắt) ---
# Dùng cho: Airflow on_failure_callback + Grafana alert rules (folder Lakehouse / Pipeline monitoring)
ALERT_WEBHOOK_URL=

# --- Dataset (CSV Olist + Clickstream), mount read-only vào postgres:/data ---
DATASET_DIR=../dataset

# --- Spark sizing ---
# spark.executor.memory mặc định 1500m → SPARK_WORKER_MEMORY phải >= 2g
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1500m
SPARK_DRIVER_MEMORY=512m

# --- Giới hạn RAM từng container (tùy chỉnh theo máy) ---
SPARK_WORKER_MEM_LIMIT=2500m
SPARK_MASTER_MEM_LIMIT=768m
AIRFLOW_MEM_LIMIT=2g
TRINO_MEM_LIMIT=1500m
KAFKA_MEM_LIMIT=1g
CONNECT_MEM_LIMIT=1g
POLARIS_MEM_LIMIT=768m
POLARIS_CONSOLE_MEM_LIMIT=256m
POSTGRES_MEM_LIMIT=512m
S3_MEM_LIMIT=512m
METABASE_MEM_LIMIT=1500m
GRAFANA_MEM_LIMIT=512m
KAFKA_UI_MEM_LIMIT=512m
FASTAPI_MEM_LIMIT=512m

# --- Image tùy chọn (CD publish lên GHCR). Để trống = build local từ Dockerfile ---
# Always deploy with `docker compose pull && docker compose up -d --no-build` (otherwise Compose may build locally and tag it with the GHCR name).
# Prefer an immutable tag (sha-<short> or a version) over :latest.
# SPARK_IMAGE=ghcr.io/<owner>/lakehouse-spark:latest
# AIRFLOW_IMAGE=ghcr.io/<owner>/lakehouse-airflow:latest
# FASTAPI_IMAGE=ghcr.io/<owner>/lakehouse-fastapi:latest

