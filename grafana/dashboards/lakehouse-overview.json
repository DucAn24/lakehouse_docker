    {
      "id": 10,
      "type": "table",
      "title": "Reviews by category (top 10)",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino-delta"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
